# Build-time settings for the extension. This file is the schema: the build
# inlines exactly these keys, nothing else.
#
# Copy it to environments/<build>.env (local.env for `npm run build`,
# development.env, production.env for `npm run build:prod`, qa.env) and fill in
# the values. Those copies are gitignored.
#
# PUBLIC VALUES ONLY. Every value ends up in the extension bundle, which anyone
# can unzip. Never add a secret (client secret, API key) here or to a copy.
#
# Each Prod/Test pair lets one build serve both environments; the environment
# is chosen at runtime.

# Backend REST base, including /api (endpoint paths such as /user/... are appended)
baseProdURL=
baseTestURL=
# Token service (user token and remote error log)
tokenProdUrl=
tokenTestUrl=
# LLM search service
llmProdUrl=
llmTestUrl=
# Keycloak base URL
keycloakProdUrl=
keycloakTestUrl=
# Keycloak realm and client id (public client)
keycloakRealm=
keycloakClientId=
# Public PKCE client of the worker's Keycloak sign-in (no secret; empty = PKCE sign-in off)
keycloakPublicClientId=
# Identity provider alias sent as kc_idp_hint; empty = "google" (the sign-in window goes straight to Google)
keycloakIdpHint=
# Google Analytics (measurement id is public; true or false)
googleAnalyticsMeasurementId=
enableGoogleAnalytics=
