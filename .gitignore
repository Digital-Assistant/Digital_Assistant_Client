# Dependencies
node_modules/

# Build outputs. dist/ is the local build:prod folder; testers and releases get the CI zip
# (GitHub prereleases test-v<version>/test-current, see the README).
build/
dist/
# Packaged extension zip, SHA256SUMS, build-info.json (scripts/ci/package-extension.sh)
out/
coverage/

# Environment files: the filled-in copies hold local values and are never committed.
# Only the schema (public key names, empty values) is tracked.
environments/*
!environments/env.example

# OS & IDE
.DS_Store
.vscode/
.idea/

# Misc
npm-debug.log*

# Local planning artefacts (not committed)
artefacts/

# Local symlink (not committed)
UDAN-Core
new-ui-html
old-ui
improvements.md
